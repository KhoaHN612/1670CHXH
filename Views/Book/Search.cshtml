@model IEnumerable<ASMProject.Models.Book>
@{
    ViewData["Title"] = "Search Book";
    Layout = "~/Views/Shared/customerLo.cshtml";
}

<div class="banner header-text">

    <div class="owl-banner owl-carousel">
        <div class="banner-item-01">
            <div class="text-content">
                <h4>Best Offer</h4>
                <h2>New Arrivals On Sale</h2>
            </div>
        </div>
        <div class="banner-item-02">
            <div class="text-content">
                <h4>Flash Deals</h4>
                <h2>Get your best products</h2>
            </div>
        </div>
        <div class="banner-item-03">
            <div class="text-content">
                <h4>Last Minute</h4>
                <h2>Grab last minute deals</h2>
            </div>
        </div>
    </div>
</div>


<div class="container">
    <div class="row">
        <div class="col-md-6">
            <div class="card-body mt-2 p-0 ">
                <form name="search">
                    <div class="form-group form-inline">
                        <input type="text" name="searchkey" style="width:300px" class="form-control form-inline" />
                        <button type="submit" class="form-control btn btn-primary" style="width:100px" />Search</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-md-6 my-auto">
            <h3 class="my-auto">Research Key: @ViewBag.key</h4>
        </div>
    </div>
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="product-item">
                    <a asp-controller="Book" asp-action="Details" asp-route-id="@item.BookId"><img
                            src="~/uploads/@Html.DisplayFor(modelItem => item.Image)" height="430px" alt="Book Image"></a>
                    <div class="down-content px-1">
                        <a asp-controller="Book" asp-action="Details" asp-route-id="@item.BookId">
                            <h4 style="width:130px; overflow: hidden; height:100px">@Html.DisplayFor(modelItem =>
                            item.Title)</h4>
                            <h5>@item.Cat.Name</h5>
                        </a>
                        <h6 class="me-0" style="position: absolute; right:0px">@String.Format("{0:0.##}", item.Price) VND
                        </h6>
                        <ul class="stars">
                            <li><i class="fa fa-star"></i></li>
                            <li><i class="fa fa-star"></i></li>
                            <li><i class="fa fa-star"></i></li>
                            <li><i class="fa fa-star"></i></li>
                            <li><i class="fa fa-star"></i></li>
                        </ul>
                        <span>Reviews (0)</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
