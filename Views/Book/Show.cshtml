@model IEnumerable<ASMProject.Models.Book>
@{
  ViewData["Title"] = "Show";
  Layout = "~/Views/Shared/customerLo.cshtml";
}

<!-- Banner Starts Here -->
<div class="banner header-text">
  <div class="owl-banner owl-carousel">
    <div class="banner-item-01">
      <div class="text-content">
        <h4>Best Offer</h4>
        <h2>New Arrivals On Sale</h2>
      </div>
    </div>
    <div class="banner-item-02">
      <div class="text-content">
        <h4>Flash Deals</h4>
        <h2>Get your best products</h2>
      </div>
    </div>
    <div class="banner-item-03">
      <div class="text-content">
        <h4>Last Minute</h4>
        <h2>Grab last minute deals</h2>
      </div>
    </div>
  </div>
</div>
<!-- Banner Ends Here -->

<div class="latest-products">
  <div class="container">
    <div class="row">
      @foreach (var item in Model)
      {
        <div class="col-md-4">
          <div class="product-item">
            <a asp-controller="Home" asp-action="ProductDetail"><img
                src="~/uploads/@Html.DisplayFor(modelItem => item.Image)" alt="Book Image" style="max-height: 500px ;"></a>
            <div class="down-content">
              <a asp-controller="Book" asp-action="Details" asp-route-id="@item.BookId">
                <h4>@Html.DisplayFor(modelItem => item.Title)</h4>
              </a>
              <h6>$ @Html.DisplayFor(modelItem => item.Price)</h6>
              <p>@Html.DisplayFor(modelItem => item.Description)</p>
              <ul class="stars">
                <li><i class="fa fa-star"></i></li>
                <li><i class="fa fa-star"></i></li>
                <li><i class="fa fa-star"></i></li>
                <li><i class="fa fa-star"></i></li>
                <li><i class="fa fa-star"></i></li>
              </ul>
              <span>Reviews (21)</span>
            </div>
            <div class="px-3 pb-3">
              <a class="btn btn-lg btn-primary w-100" asp-controller="Cart" asp-action="Create" asp-route-id="@item.BookId">Add To Cart</a>
            </div>
          </div>
        </div>
      }
    </div>
  </div>
</div>
