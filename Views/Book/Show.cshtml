@model IEnumerable<ASMProject.Models.Book>
@{
  ViewData["Title"] = "List of Books";
  Layout = "~/Views/Shared/customerLo.cshtml";
}

<div class="banner header-text">
  <div class="owl-banner owl-carousel">
    <div class="banner-item-01">
      <div class="text-content">
        <h4>Best Offer</h4>
        <h2>New Arrivals On Sale</h2>
      </div>
    </div>
    <div class="banner-item-02">
      <div class="text-content">
        <h4>Flash Deals</h4>
        <h2>Get your best products</h2>
      </div>
    </div>
    <div class="banner-item-03">
      <div class="text-content">
        <h4>Last Minute</h4>
        <h2>Grab last minute deals</h2>
      </div>
    </div>
  </div>
</div>

<div class="latest-products">
  <div class="container">

    @using (Html.BeginForm("Show", "Book"))
    {
        <div class="row w-100 my-3">
            <div class="col-md-8">
                @Html.DropDownList("category", new SelectList(ViewBag.Categories), "All Categories", new { @class = "form-control" })
            </div>
            <div class="col-md-4">
                <input type="submit" value="Filter" class="btn btn-primary" />
            </div>
        </div>
    }

    <div class="row">
      @foreach (var item in Model)
      {
        <div class="col-md-4">
          <div class="product-item">
            <a asp-controller="Book" asp-action="Details" asp-route-id="@item.BookId"><img
                src="~/uploads/@Html.DisplayFor(modelItem => item.Image)" alt="Book Image" height="430px"></a>
            <div class="down-content">
              <a asp-controller="Book" asp-action="Details" asp-route-id="@item.BookId">
                <h4 style="width:130px; overflow: hidden; height:100px">@Html.DisplayFor(modelItem => item.Title)</h4>
              </a>
              <h6>@String.Format("{0:0.##}", item.Price)</h6>
              <p style="overflow: hidden; height:100px">@Html.DisplayFor(modelItem => item.Description)</p>
              <ul class="stars">
                <li><i class="fa fa-star"></i></li>
                <li><i class="fa fa-star"></i></li>
                <li><i class="fa fa-star"></i></li>
                <li><i class="fa fa-star"></i></li>
                <li><i class="fa fa-star"></i></li>
              </ul>
              <span>Reviews (21)</span>
            </div>
            <div class="px-3 pb-3">
              <a class="btn btn-lg btn-primary w-100" asp-controller="Cart" asp-action="Create" asp-route-id="@item.BookId">Add To Cart <i class="fa-solid fa-cart-shopping"></i></a>
            </div>
          </div>
        </div>
      }
    </div>
  </div>
</div>
