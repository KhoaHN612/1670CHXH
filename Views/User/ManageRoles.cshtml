@model ASMProject.Models.UserRoleViewModel

<h2>Manage Roles for @Model.User.UserName</h2>

<form asp-action="SetRoles" method="post">
    <input asp-for="User.Id" name ="id"/>
    <div class="form-group">
        <label for="roleNames">Roles</label>
        <select asp-for="Roles" asp-items="new SelectList(Model.Roles)" multiple class="form-control">
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>