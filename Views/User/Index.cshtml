@model List<Microsoft.AspNetCore.Identity.IdentityUser>
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@{
    Layout = "~/Views/Shared/adminLo.cshtml";
    ViewData["Title"] = "Index";
}
<h2>Users</h2>
<a class="btn btn-primary my-3 rounded" asp-controller="Roles" asp-action="Index">Manage Roles</a>
<table class="table">
    <thead>
        <tr>
            <th>Username</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>
            @{
                var roles = await UserManager.GetRolesAsync(user);
                if (roles.Count > 0)
                {
                    @foreach (var role in roles)
                    {
                        <p>@role</p>
                    }
                }
            }                    
                </td>
                <td>
                    <a asp-action="Delete" asp-route-id="@user.Id">Delete</a> |
                    <a asp-action="ManageRoles" asp-route-id="@user.Id">Add Roles |</a>
                    <a asp-action="RemoveRoles" asp-route-id="@user.Id">Remove Roles</a>
                </td>
            </tr>
        }
    </tbody>
</table>