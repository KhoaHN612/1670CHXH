@{
  Layout = "~/Views/Shared/customerLo.cshtml";
}
@{
    ViewData["Title"] = "Register";
}
<!doctype html>
<html lang="en">
 

    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Register</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="../assets/vendor/bootstrap/css/bootstrap.min.css">
    <link href="../assets/vendor/fonts/circular-std/style.css" rel="stylesheet">
    <link rel="stylesheet" href="../assets/libs/css/style.css">
    <link rel="stylesheet" href="../assets/vendor/fonts/fontawesome/css/fontawesome-all.css">
    <style>
  
    body {


        align-items: center center;
        background-image: url('/assets/images/skypic3.jpg');
        background-position: center;
     
        background-size: 300px 100px;
        }

    .whitebox{
        height: 150px;
        width: 100%;
    }
    </style>

    <div class="whitebox"> </div>
    </style>



    <!-- ============================================================== -->
    <!-- login page  -->

    <!-- ============================================================== -->
    <div class="splash-container rounded"> 
        <div class="shadow-lg card ">
            <div class="card-header text-center rounded"><a asp-controller="Customer" asp-action="Index"><img class="logo-img" src="../assets/images/logo3.png" alt="logo"></a><span class="splash-description">Regist your account </span></div>
            <div class="card-body">
                <form>
                    <div class="form-group">
                        <input class="form-control form-control-lg rounded" id="username" type="text" placeholder="Username" autocomplete="off">
                    </div>
                    <div class="form-group">
                        <input class="form-control form-control-lg rounded" id="password" type="password" placeholder="Password">
                    </div>
                    <div class="form-group">
                        <input class="form-control form-control-lg rounded" id="password" type="password" placeholder="Confirm password">
                    </div>
                    <div class="form-group">
                      <input class="form-control form-control-lg rounded" id="Gmail" type="text" placeholder="Gmail">
                  </div>
                  <div class="form-group">
                    <input class="form-control form-control-lg rounded" id="password" type="text" placeholder="Adress">
                </div>
                    <button type="submit" class="btn btn-primary btn-lg btn-block rounded">Sign up</button>
                    <div class="card-footer text-center bg-white">
                        <p>Already member? <a class="text-secondary" asp-controller="Home" asp-action="Login">Login Here.</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>
  
    <script src="../assets/vendor/jquery/jquery-3.3.1.min.js"></script>
    <script src="../assets/vendor/bootstrap/js/bootstrap.bundle.js"></script>

</html>