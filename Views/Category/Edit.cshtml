@model ASMProject.Models.Category

@{
    Layout = "~/Views/Shared/adminLO.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit</title>
</head>
<body>

<h4>Category</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="CatId" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <input asp-for="Status" class="form-control" hidden/>
                @switch (@Model.Status)
                {
                    case 0:
                        <p class="text-danger">Rejected</p>
                        break;
                    case 1:
                        <p class="text-warning">Pending</p>
                        break;
                    case 2:
                        <p class="text-success">Accepted</p>
                        break;
                    default:
                        <text>Unknown</text> 
                        break;
                }
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AddBy" class="control-label"></label>
                <input asp-for="AddBy" class="form-control" value="@User.Identity.Name" readonly/>
                <span asp-validation-for="AddBy" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

</body>
</html>
