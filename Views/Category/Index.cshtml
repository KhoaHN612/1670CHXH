@model IEnumerable<ASMProject.Models.Category>

@{
    Layout = "~/Views/Shared/StrLo.cshtml";
    ViewData["Title"] = "Index";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
<div><a asp-action="Create" class="btn btn-lg btn-primary rounded my-3">Request Category</a></div>

<div class="table-responsive">
    <table class="display nowrap table table-hover table-striped table-bordered" id="dataTable" width="100%" cellspacing="0">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.AddBy)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AddBy)
                </td>
                <td>
                    @switch (item.Status)
                    {
                        case 0:
                            <p class="text-danger">Rejected</p>
                            break;
                        case 1:
                            <p class="text-warning">Pending</p>
                            break;
                        case 2:
                            <p class="text-success">Accepted</p>
                            break;
                        default:
                            <text>Unknown</text> 
                            break;
                    }
                </td>
                <td>
                    @if (item.Status == 1){
                        <a asp-action="Edit" asp-route-id="@item.CatId">Edit</a> 
                        <span>|</span>
                    }
                    <a asp-action="Details" asp-route-id="@item.CatId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.CatId">Delete</a>
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>
</body>
</html>
