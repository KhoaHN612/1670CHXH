@model IEnumerable<ASMProject.Models.Category>

@{
    Layout = "~/Views/Shared/adminLO.cshtml";
    ViewData["Title"] = "Category";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
<div><a asp-action="Create" class="btn btn-lg btn-primary rounded my-3">Request Category</a></div>

<div class="table-responsive">
    <table class="display nowrap table table-hover table-striped table-bordered" id="dataTable" width="100%" cellspacing="0">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.Name)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.AddBy)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Status)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
    @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.AddBy)
                </td>
                <td>
                    @switch (item.Status)
                    {
                        case 0:
                            <p class="text-danger">Rejected</p>
                            break;
                        case 1:
                            <p class="text-warning">Pending</p>
                            break;
                        case 2:
                            <p class="text-success">Accepted</p>
                            break;
                        default:
                            <p>Unknown</p> 
                            break;
                    }
                </td>
                <td>
                    @switch (item.Status)
                    {
                        case 1:
                            <a class="btn btn-success rounded" asp-action="ProcessStatus" asp-route-id="@item.CatId" asp-route-status="2">Accept</a>
                            <span>|</span>
                            <a class="btn btn-danger rounded" asp-action="ProcessStatus" asp-route-id="@item.CatId" asp-route-status="0">Reject</a> 
                            break;
                        case 0:
                        case 2:
                            <a class="btn btn-danger rounded" asp-action="DeleteStatus" asp-route-id="@item.CatId">Delete</a> 
                            break;
                        default:
                            <p>Unknown</p> 
                            break;
                    }          
                </td>
            </tr>
    }
        </tbody>
    </table>
</div>

</body>
</html>
