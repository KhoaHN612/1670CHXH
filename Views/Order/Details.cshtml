@model ASMProject.Models.Order

@{
    Layout = "~/Views/Shared/customerLo.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Details</title>
</head>
<body>

<div>
    <h4>Order</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CusId)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CusId)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OrTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OrTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Address)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Address)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-4">
            Order Items:
        </dt>
        <dt class = "col-sm-4">
           Price:
        </dt>
        <dt class = "col-sm-4">
            Quantity:
        </dt>
        @foreach (var item in @Model.OrderItems){
            <dd class = "col-sm-4">@item.Book.Title</dd>
            <dd class = "col-sm-4">@item.Price</dd>
            <dd class = "col-sm-4">@item.Quantity</dd>
        }
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.OrId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
</body>
</html>
