@model ASMProject.Models.Order

@{
    Layout = "~/Views/Shared/customerLo.cshtml";
}

<!DOCTYPE html>

<html>

<head>
    <meta name="viewport" content="width=device-width" />
    <title>Details</title>
</head>

<body>

    <div class="container my-3">
        <div>
            <h3>Order Detail</h3>
            <hr />
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.CusId)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.CusId)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.OrTime)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.OrTime)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Address)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Address)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Status)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Status)
                </dd>
                <dt class="col-sm-4">
                    Order Items:
                </dt>
                <dt class="col-sm-4">
                    Image:
                </dt>
                <dt class="col-sm-2">
                    Price:
                </dt>
                <dt class="col-sm-2">
                    Quantity:
                </dt>
                @foreach (var item in @Model.OrderItems)
                {
                    <dd class="col-sm-4">@item.Book.Title</dd>
                    <dd class="col-sm-4"><img src="~/uploads/@item.Book.Image" width="100px" height="150px" alt=""></dd>
                    <dd class="col-sm-2">@item.Price</dd>
                    <dd class="col-sm-2">@item.Quantity</dd>
                }
            </dl>
        </div>
        <div>
            <a asp-action="Index">Back to List</a>
        </div>
    </div>
</body>

</html>
