@model ASMProject.Models.Order

@{
    Layout = "~/Views/Shared/customerLo.cshtml";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Create</title>
</head>
<body>

<h4>Order</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label class="control-label">User Name</label>
                <input asp-for="CusId" class="form-control" value="@User.Identity.Name" readonly/>
                <span asp-validation-for="CusId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Order Time</label>
                <input asp-for="OrTime" class="form-control" value=@DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") readonly/>
                <span asp-validation-for="OrTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Address" class="control-label"></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <input asp-for="Status" value="Waiting" class="form-control" readonly/>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Make Order" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

</body>
</html>
