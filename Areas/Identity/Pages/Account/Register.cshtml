@page
@model RegisterModel
@{
    Layout = "~/Views/Shared/customerLo.cshtml";
}
@{
    ViewData["Title"] = "Register";
}


<!doctype html>
<html lang="en">


<!-- Required meta tags -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
<title>Register</title>
<!-- Bootstrap CSS -->
<link rel="stylesheet" href="../assets/vendor/bootstrap/css/bootstrap.min.css">
<link href="../assets/vendor/fonts/circular-std/style.css" rel="stylesheet">
<link rel="stylesheet" href="../assets/libs/css/style.css">
<link rel="stylesheet" href="../assets/vendor/fonts/fontawesome/css/fontawesome-all.css">
<style>
    body {


        align-items: center center;
        background-image: url('/assets/images/skypic3.jpg');
        background-position: center;

        background-size: 300px 100px;
    }

    .whitebox {
        height: 150px;
        width: 100%;
    }

    .custom-container {
        max-width: 600px;
        /* Set the maximum width of the container */
        padding: 20px;
        /* Optional: Add padding for spacing inside the container */
    }
</style>

<div class="whitebox"> </div>

<div class="container custom-container rounded">
    <div class="shadow-lg card ">
        <div class="card-header text-center rounded"><a asp-controller="Customer" asp-action="Index"><img
                    class="logo-img" src="../../assets/images/logo3.png" alt="logo"></a>
        </div>
        <div class="card-body">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <h2 class=" text-center ">Create a new account.</h2>
                <hr />
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-group">
                    <label asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" class="form-control form-control-lg rounded" autocomplete="username"
                        aria-required="true" placeholder="name@example.com" />

                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password" class="form-control form-control-lg rounded"
                        autocomplete="new-password" aria-required="true" placeholder="password" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                    <input asp-for="Input.ConfirmPassword" class="form-control form-control-lg rounded"
                        autocomplete="new-password" aria-required="true" placeholder="password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>
                <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
                   <div class="card-footer text-center bg-white">
                        <p>Already member? <a class="text-secondary" asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Login Here.</a></p>
                    </div>
            </form>
        </div>
    </div>
