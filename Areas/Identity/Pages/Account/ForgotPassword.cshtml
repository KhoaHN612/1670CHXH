@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot your password?";
}

<style>
    body {


        align-items: center center;
       
        background-position: center;

        background-size: 300px 100px;
    }

    .whitebox {
        height: 150px;
        width: 100%;
    }
    .custom-container {
        max-width: 700px;
        max-height: 900px;
        /* Set the maximum width of the container */
        padding: 10px;
        /* Optional: Add padding for spacing inside the container */
    }
    .form-floating {
    margin-bottom: 10px; /* Add margin between form elements */
}

.form-floating input {
    width: 100%;
}
</style>

<h1 class="text-center">@ViewData["Title"]</h1>
@* <div class="whitebox"> </div> *@
<!-- This is form -->
<div class=" container custom-container rounded " style="width: 100%">
    <div class="shadow-lg card d-flex">
        <h2 class="text-center">Enter your email.</h2>
        <hr />   
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <div class="form-group mb-3 ">
                        <label asp-for="Input.Email" class="form-label ml-4 fs-2"></label>
                        <input asp-for="Input.Email" class="form-control form-control-sm rounded fs-5" autocomplete="username" aria-required="true" placeholder="name@example.com" />    
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="text-center mb-3">
                    <button type="submit" class="text-center btn btn-lg btn-primary">Reset Password</button>
                    </div>
                </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
